{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Manrope|Spectral|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Manrope, Spectral, JetBrains Mono."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--bubble-in",
      "--bubble-out",
      "--bubble-out-2",
      "--bubble-shadow",
      "--chat-bg",
      "--chat-bg-2",
      "--err",
      "--font",
      "--font-mono",
      "--font-serif",
      "--gold",
      "--hairline",
      "--ink",
      "--ink-2",
      "--ink-3",
      "--ink-4",
      "--ink-5",
      "--link",
      "--mono",
      "--ok",
      "--on-overlay",
      "--on-overlay-2",
      "--overlay",
      "--overlay-soft",
      "--r-bubble",
      "--r-bubble-tail",
      "--r-card",
      "--r-pill",
      "--r-thumb",
      "--surface",
      "--surface-2",
      "--t-body",
      "--t-caption",
      "--t-h",
      "--t-meta",
      "--t-title",
      "--tg-blue",
      "--tg-blue-deep",
      "--tg-blue-soft",
      "--warn"
    ],
    "tokenKinds": {
      "--tg-blue": "color",
      "--tg-blue-deep": "color",
      "--tg-blue-soft": "color",
      "--bubble-out": "color",
      "--bubble-out-2": "color",
      "--bubble-in": "color",
      "--bubble-shadow": "shadow",
      "--chat-bg": "color",
      "--chat-bg-2": "color",
      "--ink": "color",
      "--ink-2": "color",
      "--ink-3": "color",
      "--ink-4": "color",
      "--ink-5": "color",
      "--link": "color",
      "--ok": "color",
      "--warn": "color",
      "--err": "color",
      "--gold": "color",
      "--surface": "color",
      "--surface-2": "color",
      "--hairline": "color",
      "--overlay": "color",
      "--overlay-soft": "color",
      "--on-overlay": "color",
      "--on-overlay-2": "color",
      "--r-bubble": "spacing",
      "--r-bubble-tail": "spacing",
      "--r-card": "spacing",
      "--r-pill": "spacing",
      "--r-thumb": "spacing",
      "--font": "font",
      "--font-serif": "font",
      "--font-mono": "font",
      "--mono": "other",
      "--t-meta": "spacing",
      "--t-caption": "spacing",
      "--t-body": "spacing",
      "--t-title": "spacing",
      "--t-h": "spacing"
    },
    "fontFamilies": [
      "JetBrains Mono",
      "Manrope",
      "Spectral"
    ]
  }
}